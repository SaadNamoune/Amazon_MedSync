FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir --no-deps monai==1.6.0

COPY src/ src/
COPY scripts/ scripts/

ENV PYTHONPATH=/app/src

EXPOSE 8000
CMD ["uvicorn", "medsync.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
